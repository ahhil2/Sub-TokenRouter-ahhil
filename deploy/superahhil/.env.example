# .env.example supplies the SuperAHHil Compose deployment's image, credentials,
# and optional notification settings. Notification examples remain commented
# so mounted YAML can configure conversion; uncomment the global switch or
# user list to supply an environment override.
HOST_PORT=18080
TOKENROUTER_IMAGE=ghcr.io/ahhil2/tokenrouter:0.4.1
APP_VERSION=0.4.1
APP_COMMIT=local
BUILD_DATE=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# Enable notifications for all API-key callers, or select user IDs separately.
# An empty configured user list clears the corresponding mounted YAML list.
# GATEWAY_CODEX_CLIENT_NOTIFICATIONS=true
# GATEWAY_CODEX_CLIENT_NOTIFICATION_USER_IDS=101,102
